DirectoryIndex index.html index.htm

RewriteEngine On

# Старые страницы блога на старом домене -> соответствующие страницы
# нового домена одним прямым 301. Это убирает цепочки редиректов.
RewriteCond %{HTTP_HOST} ^(www\.)?3-d-shop\.ru$ [NC]
RewriteRule ^blog/(top-10-podarkov|mnogocvetnaya-pechat|pla-vs-petg|stl-3mf-obj|3d-modeli-dlya-3d-printera)/?$ https://3dvesh.ru/blog/$1 [R=301,L]

# Старые карточки товаров -> актуальный каталог, сразу на HTTPS.
RewriteRule ^catalog/(bottle-bike-mount|desk-cable-box|door-handle-cover|makeup-brush-holder|small-parts-organizer)$ https://3dvesh.ru/catalog/ [R=301,L]

# Принудительный HTTPS. %{HTTPS} тут всегда off (SSL терминируется до
# Apache) — проверяем X-Forwarded-Proto вместо него.
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://3dvesh.ru/$1 [R=301,L]

# Виртуальные страницы (например /blog/article/) не являются
# реальными директориями: убираем завершающий slash и оставляем
# единственный канонический URL без slash.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+?)/$ https://3dvesh.ru/$1 [R=301,L,NE]

# /catalog, /blog (реальные директории) -> /catalog/, /blog/ — со своим
# явным https://, без опоры на определение схемы сервером.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*[^/])$ https://3dvesh.ru/$1/ [R=301,L]

# Файлы-подтверждения поисковиков должны отвечать 200 ровно по адресу с .html.
RewriteRule ^(yandex_[a-f0-9]+\.html|google[a-f0-9]+\.html)$ - [L]

# example.html -> example (канонические extensionless-ссылки)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page/index.html -> /page/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Внутренний rewrite extensionless-запроса в соответствующий .html-файл
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
