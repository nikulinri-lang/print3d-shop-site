DirectoryIndex index.html index.htm

# Apache отдаёт автоматический 301 на /path/ для реальных директорий
# (catalog/, blog/) сам, но не знает, что соединение пришло по HTTPS —
# Timeweb терминирует SSL до Apache, поэтому такой редирект уходит на
# http://, понижая протокол у живых пользователей. Отключаем встроенный
# редирект и делаем его сами ниже с явным https://.
DirectorySlash Off

RewriteEngine On

# Единое зеркало: www -> основной домен без www.
RewriteCond %{HTTP_HOST} ^www\\.3-d-shop\\.ru$ [NC]
RewriteRule ^(.*)$ https://3-d-shop.ru/$1 [R=301,L]

# Старые карточки товаров -> актуальный каталог, сразу на HTTPS.
RewriteRule ^catalog/(bottle-bike-mount|desk-cable-box|door-handle-cover|makeup-brush-holder|small-parts-organizer)$ https://3-d-shop.ru/catalog/ [R=301,L]


# Принудительный HTTPS. %{HTTPS} тут всегда off (SSL терминируется до
# Apache) — проверяем X-Forwarded-Proto вместо него. Диагностикой
# подтверждено (09.09.2026): при реальном HTTPS-запросе nginx кладёт сюда
# ровно "https"; при реальном HTTP — заголовка нет вообще (пустая
# строка), а НЕ "http". Поэтому сравнение !=https (а не =http) — иначе
# редирект никогда не срабатывал для большинства страниц, кроме тех, что
# ловились соседним directory-slash правилом ниже. !=https безопасен от
# зацикливания именно потому, что для настоящего HTTPS сервер всегда
# ставит "https" (проверено), так что уже-https запросы это условие не
# матчат и повторно не редиректятся.
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://3-d-shop.ru/$1 [R=301,L]

# /catalog, /blog (реальные директории) -> /catalog/, /blog/ — со своим
# явным https://, без опоры на определение схемы сервером.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*[^/])$ https://3-d-shop.ru/$1/ [R=301,L]

# Файлы-подтверждения поисковиков (yandex_*.html, google*.html) должны
# отвечать 200 РОВНО по адресу с .html — общее правило ниже сняло бы
# .html 301-редиректом и сломало бы верификацию сайта.
RewriteRule ^(yandex_[a-f0-9]+\.html|google[a-f0-9]+\.html)$ - [L]

# example.html -> example (канонические extensionless-ссылки)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page/index.html -> /page/
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Внутренний rewrite extensionless-запроса в соответствующий .html-файл
# (только если запрошенный путь — не реальная директория, чтобы не
# конфликтовать с /catalog/, /blog/, где лежат страницы товаров/статей)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
